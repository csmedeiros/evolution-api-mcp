{
  "name": "evolution-api-mcp",
  "version": "1.0.0",
  "description": "MCP server for Evolution API - search and execute 60+ WhatsApp endpoints via natural language",
  "type": "module",
  "bin": {
    "evolution-api-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup src/server.ts --format esm --out-dir dist --dts",
    "dev": "tsx src/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.29.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}

{
  "name": "evolution-api-mcp",
  "version": "1.0.0",
  "description": "MCP server for Evolution API - search and execute 60+ WhatsApp endpoints via natural language",
  "type": "module",
  "bin": {
    "evolution-api-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup src/server.ts --format esm --out-dir dist --dts",
    "dev": "tsx src/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.29.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.19.0",
    "jsonwebtoken": "^9.0.0",
    "minisearch": "^7.2.0",
    "pg": "^8.12.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
